# ==============================================================================
# ELEVENLABS CONFIGURATION
# ==============================================================================

# 1. ElevenLabs API Key
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 2. ElevenLabs Voice ID
# You can copy any voice ID from the ElevenLabs Voice Library or Voice Lab.
# Examples of popular voices:
# - George (Warm, British, Storyteller): JBFqnCBsd6RMkjVDRZzb
# - Adam (Deep, Narrative, American):    pNInz6obpgDQGcFmaJgB
# - Charlie (Casual, Australian):        IKne3meq5aSn9XLyUdCD
# - Callum (Husky, Intense):             N2lVS1w4EtoT3dr4eOWO
# - Daniel (Authoritative, British):     onwK4e9ZLuTAKqWW03F9
# - Eric (Friendly, Conversational):     cjVigY5qzO86Huf0OWal
# - Will (Youthful, Engaging):           bIHbv24MWmeRgasZH58o
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# 3. ElevenLabs Model Selection
# Select the active model below by setting ELEVENLABS_MODEL_ID.
# Default recommended: eleven_multilingual_v2 (highest quality, depth, and emotion)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ------------------------------------------------------------------------------
# COMPLETE LIST OF ELEVENLABS VOICE MODELS (REFERENCE & COMMENT LIST)
# ------------------------------------------------------------------------------
# 1. eleven_multilingual_v2
#    - Name: Eleven Multilingual v2
#    - Description: Cutting-edge, high-fidelity emotional model. Supports 29 languages.
#      Best for rich storytelling, document narration, and YouTube explainers.
#
# 2. eleven_turbo_v2_5
#    - Name: Eleven Turbo v2.5
#    - Description: High quality with ultra-low latency (~250-300ms) across 32 languages.
#      Cost-efficient (~50% less credit consumption than Multilingual v2).
#
# 3. eleven_flash_v2_5
#    - Name: Eleven Flash v2.5
#    - Description: Ultra-fast generation (~75ms latency), ideal for real-time applications
#      and rapid bulk drafting across 32 languages at very low cost.
#
# 4. eleven_turbo_v2
#    - Name: Eleven Turbo v2
#    - Description: English-only fast turbo model. Low latency, good quality for English.
#
# 5. eleven_multilingual_v1
#    - Name: Eleven Multilingual v1
#    - Description: First-generation multilingual model. Supports English, German, Polish,
#      Spanish, Italian, French, Portuguese, and Hindi. (Legacy)
#
# 6. eleven_monolingual_v1
#    - Name: Eleven English v1
#    - Description: Original classic monolingual English model. Fast and stable for English. (Legacy)
# ------------------------------------------------------------------------------

# Optional Voice Settings (0.0 to 1.0)
ELEVENLABS_STABILITY=0.50
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.15
ELEVENLABS_USE_SPEAKER_BOOST=true
